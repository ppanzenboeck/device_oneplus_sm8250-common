allow system_server sysfs:file { getattr open read };
allow system_server sysfs_batteryinfo:file { getattr open read };
allow system_server vendor_sysfs_battery_supply:file { getattr open read };
allow system_server vendor_sysfs_battery_supply:dir { search };
allow system_server vendor_sysfs_usb_supply:file { getattr open read };
allow system_server vendor_sysfs_usb_supply:dir { search };
